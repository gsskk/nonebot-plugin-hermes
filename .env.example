# ============================================================
# NoneBot 基础配置
# ============================================================

DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
COMMAND_START=["/"]
COMMAND_SEP=["."]

# ============================================================
# 适配器配置（根据你使用的 adapter 选择配置）
# ============================================================

# --- OneBot v11 (NapCatQQ, LLOneBot, go-cqhttp 等) ---
# 方式一：正向 WebSocket（NoneBot 主动连接 OneBot 实现端）
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
# ONEBOT_ACCESS_TOKEN=

# 方式二：反向 WebSocket（OneBot 实现端主动连接 NoneBot）
# 注释掉上方 ONEBOT_WS_URLS，将 HOST 改为 0.0.0.0，
# 然后在 NapCatQQ/LLOneBot 中配置反向 WS 地址为:
#   ws://<NoneBot IP>:<PORT>/onebot/v11/ws

# --- QQ Official Bot ---
# QQ_BOTS='[{"id":"xxx","token":"xxx","secret":"xxx","intent":{"at_messages":true}}]'

# ============================================================
# Hermes Agent 配置
# ============================================================

# Hermes API Server 地址（对应 hermes gateway 的 api_server 端口）
HERMES_API_URL=http://127.0.0.1:8642

# Hermes API Key（需与 ~/.hermes/.env 中的 API_SERVER_KEY 一致）
# 生成命令: python -c "import secrets; print(secrets.token_hex(32))" 或 openssl rand -hex 32
HERMES_API_KEY=

# API 超时时间（秒），Agent 执行工具可能较慢
HERMES_API_TIMEOUT=300

# ============================================================
# 触发模式
# ============================================================

# 群聊触发方式: at / all / keyword
HERMES_GROUP_TRIGGER=at

# keyword 模式下的触发关键词（JSON 数组）
# HERMES_KEYWORDS=["/ai", "小助手"]

# 私聊触发方式: all / allowlist
HERMES_PRIVATE_TRIGGER=all

# 允许私聊的用户 ID（allowlist 模式，JSON 数组）
# HERMES_ALLOW_USERS=["12345678"]

# 允许响应的群组 ID（空 = 全部允许，JSON 数组）
# HERMES_ALLOW_GROUPS=["987654321"]

# 管理员白名单，格式 "<adapter>:<user_id>"，adapter 取小写+去空格点
# (telegram / onebotv11 / discord / kook / ...)。默认空集 = deny by default,
# /hermes-status 等敏感命令必须命中才会执行。
# HERMES_ADMIN_USERS=["telegram:7055555877", "onebotv11:12345678"]

# ============================================================
# 会话设置
# ============================================================

# 群内是否共享 session（false = 每人独立对话）
HERMES_SESSION_SHARE_GROUP=false

# ============================================================
# 消息设置
# ============================================================

# 单条回复最大长度（QQ 限制约 4500 字符）
HERMES_MAX_LENGTH=4000

# 以这些字符开头的消息不触发回复（JSON 数组）
HERMES_IGNORE_PREFIX=["."]

# ============================================================
# 被动感知 (Chat Awareness)
# ============================================================

# 是否开启被动感知:在群聊 + active_session=false 下,@bot 时给 LLM 注入
# 旁观历史(其他人之前在群里聊了什么)。私聊不注入——Hermes session 已覆盖。
# 注意:HERMES_ACTIVE_SESSION_ENABLED=true 时被动感知自动隐含为 on,本开关无效。
HERMES_PERCEPTION_ENABLED=false

# 被动感知缓存的历史消息数量
HERMES_PERCEPTION_BUFFER=10

# 被动感知单条历史消息最大长度（超出截断）
HERMES_PERCEPTION_TEXT_LENGTH=200

# 历史记录中的图片占位行为(0.3 起仅控制占位文本,不再控制多模态注入):
#   placeholder / inline_labeled / 其他非 none 值
#                    在历史文本里加 [图片] 占位(默认行为)
#   none             完全不加 [图片] 占位
#
# ⚠️ 0.3 起,历史图片召回改走 MCP 工具 get_message_images,本配置不再控制
# 多模态注入。inline_labeled 模式已与 placeholder 等效。下一个 major 版本
# 会简化为布尔开关 hermes_perception_show_image_placeholder。
HERMES_PERCEPTION_IMAGE_MODE=placeholder

# ============================================================
# M1 — 群活跃态 (实验性)
# ============================================================

# 启用后,@bot 触发后 5 分钟内 bot 会监听话题相关消息并按需主动插话。
# 关闭(默认)则退化为 v0.1.6 等价行为(只有显式触发才回复)。
# HERMES_ACTIVE_SESSION_ENABLED=false

# 活跃窗口 TTL(秒),每次插话滑动续期。300 = 5 分钟。
# HERMES_ACTIVE_SESSION_TTL_SEC=300

# 过期清扫 cron 频率(秒)。
# HERMES_ACTIVE_SWEEP_INTERVAL_SEC=30

# ============================================================
# OneBot v11 — Notice 事件触发 (Phase A, 0.3.3+)
# ============================================================

# 戳一戳:被戳时触发对话,等价于被 @。私聊 / 群聊都生效。
# 其他适配器(Discord/Telegram/QQ 官方/Kook)无 poke 概念,静默忽略。
# HERMES_POKE_TRIGGER_ENABLED=false

# 入群欢迎:仅在 HERMES_ACTIVE_SESSION_ENABLED=true 的群里生效——
# 有新人加入时触发一次 reactive turn,让 Hermes 通过 decision_protocol 自己
# 决定要不要欢迎(noop 是合法返回,避免做成千篇一律的模板 spam bot)。
# active 关时不触发——passive 是 1:1 Q&A 语义,不适用欢迎场景。
# HERMES_GREET_ON_JOIN=false

# ============================================================
# Phase B-0 — Ack 反馈 + 非文本段感知 (0.3.4+)
# ============================================================

# 是否启用 ack 反馈 (用户消息上贴 emoji / 显示 typing 等):
# - OneBot v11 (NapCat/LLOneBot): 在用户 @ bot 那条消息上贴 emoji,chat 完成后撤销
# - 其他适配器: 当前 silent no-op,B-0.5 规划里会扩 Telegram/Discord 私聊 typing
# 开关名通用,前瞻一步避免 B-0.5 改名 breaking。
# HERMES_ACK_FEEDBACK_ENABLED=false

# 贴的 QQ 表情 id。默认 424 ('看见')。
# 完整列表见 NapCat / OneBot face_id 表 (https://napcat.napneko.icu/...)。
# HERMES_ACK_EMOJI_ID=424

# 非文本段 (语音/视频/QQ大表情包/face 表情) 占位是自动行为,无开关——
# 之前这些段被静默忽略 (sticker 还会误进 vision API 烧 token),修了即受益。

# ⚠️ 0.3 起空转:MessageBuffer 改为 SQLite 后端,无内存 per-group / total
# 上限的概念,消息淘汰改由 HERMES_STORAGE_MESSAGE_* 控制。本两项保留是
# 为不破坏旧 .env 文件 import;下一个 major 版本会移除。
# HERMES_BUFFER_PER_GROUP_CAP=200
# HERMES_BUFFER_TOTAL_GROUPS_CAP=50

# ============================================================
# M1 — 反向 MCP 通道 (实验性)
# ============================================================

# 启用后插件起一个本地 MCP server,让 Hermes Agent 主动调用 push_message /
# list_active_sessions / get_recent_messages / get_message_images 等工具。
# 配套需要:
#   1. 跑 `hermes-install-skill` 把 SKILL.md 装到 ~/.hermes/skills/
#   2. 在 ~/.hermes/config.yaml 注册 nonebot-bridge MCP server
# HERMES_MCP_ENABLED=false

# MCP server 绑定地址。默认 loopback (127.0.0.1)。
# 改成监听公网/局域网地址在技术上完全可行,但安全代价:push_message 工具
# 能让 bot 往群里发任意内容,而前端防御只有 Bearer token(明文 HTTP,且
# 与 HERMES_API_KEY 同钥匙)。改之前请上反向代理 + TLS + 来源 IP ACL。
# HERMES_MCP_HOST=127.0.0.1

# MCP server 绑定端口。
# HERMES_MCP_PORT=8643

# get_recent_messages 工具单次返回上限。
# HERMES_MCP_RECENT_LIMIT_MAX=50

# ============================================================
# 0.3 — 持久化存储(历史图片召回依赖)
# ============================================================

# SQLite 消息日志路径。空值走 nonebot-plugin-localstore 解析,通常是:
#   ~/.local/share/nonebot2/nonebot_plugin_hermes/messages.db
# localstore 也支持 LOCALSTORE_* env vars 全局重定向,优先级最高。
# HERMES_STORAGE_DB_PATH=

# 消息日志保留天数。超龄行由整点 :37 的 vacuum cron 删除。
# HERMES_STORAGE_MESSAGE_RETENTION_DAYS=30

# 消息日志总行数硬上限。超出后 vacuum 按 ts 老到新删。
# HERMES_STORAGE_MESSAGE_MAX_ROWS=100000

# 图字节缓存目录。空值走 localstore 的 plugin_cache_dir,通常是:
#   ~/.cache/nonebot2/nonebot_plugin_hermes/images/
# 命名: <sha256>.<ext>,扁平布局。
# HERMES_IMAGE_CACHE_DIR=

# 图缓存总体积上限(MB)。超出由 vacuum 按 atime 老到新淘汰。
# 默认 200 → 大概能放 1000-2000 张普通群聊图。
# HERMES_IMAGE_CACHE_QUOTA_MB=200

# 单图 HTTP 抓取超时秒数。
# HERMES_IMAGE_FETCH_TIMEOUT_S=10

# 单图总尝试次数。1=不重试,2=一次重试,以此类推。
# QQ 这种短效 URL 重试意义不大,默认 2 已够。
# HERMES_IMAGE_FETCH_MAX_ATTEMPTS=2
